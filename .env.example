# ─────────────────────────────────────────────────────────────────────────────
# Credit Intelligence Dashboard — Environment Variables
#
# Copy this file to .env and fill in values for local development.
# On Replit, all secrets are managed via the Secrets panel (not .env files).
#
# Required variables are marked [REQUIRED].
# Variables with defaults are marked [DEFAULT: value].
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# On Replit: auto-provisioned — do not set manually.
# Locally: start the DB with: docker-compose -f docker-compose.dev.yml up -d
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/credit_intel  # [REQUIRED]

# ── AI / OpenAI ───────────────────────────────────────────────────────────────
# Standard OpenAI API key. Used when Replit AI proxy vars (below) are absent.
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...  # [REQUIRED unless using Replit AI proxy]

# Replit AI proxy (takes priority over OPENAI_API_KEY when both are set).
# These are injected automatically inside Replit. Leave commented out locally.
# AI_INTEGRATIONS_OPENAI_API_KEY=...
# AI_INTEGRATIONS_OPENAI_BASE_URL=...

# ── News Feeds ────────────────────────────────────────────────────────────────
# NewsAPI.org key — https://newsapi.org/register
# Note: currently invalid in this project; RSS feeds are the primary source.
NEWS_API_KEY=...  # [OPTIONAL — RSS feeds work without this]

# ── Session Security ──────────────────────────────────────────────────────────
# Secret used for signing session cookies. Use a long random string in prod.
SESSION_SECRET=change-me-in-production  # [REQUIRED in production]

# ── Server Ports ──────────────────────────────────────────────────────────────
# API server port.
# On Replit: injected automatically as PORT. Do not set manually on Replit.
# Locally: set to any available port. Must match VITE_API_PORT below.
API_PORT=8080  # [DEFAULT: 8080]

# Frontend dev server port.
# On Replit: injected automatically as PORT (per-artifact). Do not set manually.
# Locally: set to any available port other than API_PORT.
PORT=5173  # [DEFAULT: 5173] — used by Vite dev server

# ── Vite Base Path (Replit-specific) ─────────────────────────────────────────
# Injected by Replit's artifact router for path-based proxy routing.
# Leave unset for local development — the frontend defaults to serving at /.
# BASE_PATH=/credit-dashboard  # [Replit-injected — do not set locally]
